# One var, two consumers:
# - Vite exposes it to the browser as import.meta.env.VITE_API_URL (dev mode,
#   and the dashboard at runtime in prod).
# - scripts/fetch-data.mjs (a plain Node script, run via `node
#   --env-file-if-exists=.env`) reads it as process.env.VITE_API_URL to know
#   where to fetch build-time data from.
VITE_API_URL=http://localhost:8080
